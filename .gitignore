# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Google service-account keys — NEVER commit. Reference them by path via
# GOOGLE_APPLICATION_CREDENTIALS instead. Defensive patterns in case a key
# file ever lands in the repo tree.
link-backend-*.json
*-service-account.json
*serviceaccount*.json
gcp-credentials*.json

# Claude Code local session metadata — machine-local, never commit
local_*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Responsive verification output (scripts/responsive/*) — REGENERABLE, and the
# screenshot matrix is 67 views x 9 viewports of PNGs. Run `npm run
# responsive:verify` to rebuild. The JSON baselines are NOT ignored: the whole
# point of Phase 8 is that A11Y-BASELINE.json is the number the sweep has to
# move, so it belongs in review.
/docs/responsive/screens/
