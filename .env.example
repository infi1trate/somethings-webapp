# Google Vertex AI — Claude access. Copy to .env.local and fill in.
#
# The app calls Claude via Vertex AI (no Anthropic API key). If these aren't
# set, the suggest-interests route falls back to a mock so the demo still works.

# GCP project with Vertex AI enabled and the Anthropic Claude models available.
ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id

# Vertex endpoint region. "global" = maximum availability, no pricing premium.
# Use a specific region (e.g. us-east5) only for data-residency requirements.
CLOUD_ML_REGION=global

# Absolute path to a Google service-account JSON key (Application Default
# Credentials). The service account needs the "Vertex AI User" role
# (roles/aiplatform.user). Keep this file OUT of the repo — never commit it.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ── THE DEMO GATE ───────────────────────────────────────────────────────────
# Shared password in front of the deployed prototype. See src/middleware.ts.
#
# The middleware falls back to a literal if this is unset, so the deployment is
# gated the moment it ships rather than silently open until someone remembers to
# configure it — a secret that fails OPEN is the worse default. Set this in the
# Vercel project to change the password WITHOUT a code deploy, and note that
# changing it invalidates every existing cookie, so everyone signs in again.
#
# The gate is production-only: `next dev` is never gated, so local work and the
# responsive harness in scripts/responsive/ are unaffected. To exercise it
# locally, build and serve a production bundle: npm run build && npm start
SITE_PASSWORD=
