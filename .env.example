# Google Vertex AI — Claude access. Copy to .env.local and fill in.
#
# The app calls Claude via Vertex AI (no Anthropic API key). If these aren't
# set, the suggest-interests route falls back to a mock so the demo still works.

# GCP project with Vertex AI enabled and the Anthropic Claude models available.
ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id

# Vertex endpoint region. "global" = maximum availability, no pricing premium.
# Use a specific region (e.g. us-east5) only for data-residency requirements.
CLOUD_ML_REGION=global

# Absolute path to a Google service-account JSON key (Application Default
# Credentials). The service account needs the "Vertex AI User" role
# (roles/aiplatform.user). Keep this file OUT of the repo — never commit it.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
